msgid "Votre demande a bien été envoyée. Nous vous répondrons rapidement."
msgstr "Your request has been sent. We will get back to you shortly."

msgid ""
"Merci ! Votre message a bien été envoyé, nous vous répondrons rapidement."
msgstr ""
"Thank you! Your message has been sent, we will get back to you shortly."

msgid ""
"Votre demande de réservation a bien été envoyée. Nous vous confirmons "
"rapidement."
msgstr "Your booking request has been sent. We will confirm shortly."

msgid "La date doit être dans le futur."
msgstr "The date must be in the future."

msgid "Au moins un adulte."
msgstr "At least one adult."

