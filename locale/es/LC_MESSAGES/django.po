msgid "Morocco Riwa Tours — Excursions & circuits authentiques dans le Sahara"
msgstr "Morocco Riwa Tours — Excursiones y circuitos auténticos en el Sahara"

msgid ""
"Agence locale à Merzouga : excursions dans le désert, nuits en campement "
"berbère, balades à dos de chameau et circuits sur mesure au Maroc."
msgstr ""
"Agencia local en Merzouga: excursiones en el desierto, noches en campamento "
"bereber, paseos en camello y circuitos a medida en Marruecos."

msgid "Accueil"
msgstr "Inicio"

msgid "Circuits"
msgstr "Circuitos"

msgid "À propos"
msgstr "Sobre nosotros"

msgid "Contact"
msgstr "Contacto"

