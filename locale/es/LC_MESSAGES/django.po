msgstr "Reservar"

msgid ""
"Agence locale basée à Merzouga, aux portes de l'Erg Chebbi. Nous organisons "
"des excursions authentiques dans le Sahara marocain depuis des années, avec "
"des guides berbères passionnés."
msgstr ""
"Agencia local con sede en Merzouga, a las puertas del Erg Chebbi. Llevamos "
"años organizando excursiones auténticas en el Sahara marroquí, con guías "
"bereberes apasionados."

msgid "Navigation"
msgstr "Navegación"

msgid "Nos circuits"
msgstr "Nuestros circuitos"

msgid "Merzouga, Maroc"
msgstr "Merzouga, Marruecos"

msgid "Tous droits réservés."
msgstr "Todos los derechos reservados."

msgid "Conçu à Merzouga, porte du Sahara."
msgstr "Diseñado en Merzouga, puerta del Sahara."

