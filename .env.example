# Copiez ce fichier en ".env" (même dossier que manage.py) et remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être publié (il est déjà dans .gitignore).

# --- Obligatoire en production ---
DJANGO_DEBUG=False
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=moroccoriwatours.com,www.moroccoriwatours.com
DJANGO_SITE_URL=https://moroccoriwatours.com

# Adresse secrète de l'admin (évitez "admin/"). Exemple : gestion-x7k2/
DJANGO_ADMIN_URL=gestion-x7k2/

# Mettre True si l'hébergeur place un proxy HTTPS devant Django (PythonAnywhere, Render, Nginx...)
DJANGO_BEHIND_PROXY=True
# Mettre True pour que Django serve les photos envoyées depuis l'admin
DJANGO_SERVE_MEDIA=True

# --- Coordonnées affichées sur le site (footer, page Contact, Google) ---
DJANGO_CONTACT_PHONE=+212 6 88 69 45 28
DJANGO_CONTACT_EMAIL=riwatoursmorocco@gmail.com
# Lien Google Maps ouvert quand on clique sur la localisation
DJANGO_MAPS_URL=https://maps.app.goo.gl/tFVeQxHwsSpJeNiU7?g_st=aw
# Numéro WhatsApp qui reçoit les confirmations de réservation.
# Format international (212688694528) ou local marocain (0688694528) : le site le convertit.
DJANGO_WHATSAPP_NUMBER=212688694528

# --- Vercel uniquement (voir DEPLOY_VERCEL.md) ---
# Base PostgreSQL externe (Supabase : « Transaction pooler »).
DATABASE_URL=postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Stockage des photos compatible S3 (exemple Supabase Storage)
DJANGO_S3_BUCKET=media
DJANGO_S3_ENDPOINT=https://VOTRE-REF.supabase.co/storage/v1/s3
DJANGO_S3_REGION=eu-west-3
DJANGO_S3_ACCESS_KEY=
DJANGO_S3_SECRET_KEY=
# Adresse publique des photos, sans https://
DJANGO_S3_PUBLIC_DOMAIN=VOTRE-REF.supabase.co/storage/v1/object/public/media

# --- Facultatif : emails d'alerte pour vous à chaque réservation / message ---
DJANGO_NOTIFY_EMAIL=riwatoursmorocco@gmail.com
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=riwatoursmorocco@gmail.com
DJANGO_EMAIL_PASSWORD=mot-de-passe-application
DJANGO_FROM_EMAIL=Morocco Riwa Tours <riwatoursmorocco@gmail.com>

# --- Optionnel ---
# DJANGO_HSTS_SECONDS=31536000   # à activer quand le HTTPS marche parfaitement
# DJANGO_SSL_REDIRECT=True
